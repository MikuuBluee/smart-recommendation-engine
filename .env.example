# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# PostgreSQL Configuration
DATABASE_URL=postgresql://recommender:recommender123@localhost:5432/recommendations

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=Olist_Recommender

# Model Configuration
MODEL_COMPONENTS=30
MODEL_LEARNING_RATE=0.05
MODEL_LOSS=warp
MODEL_EPOCHS=10

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Cache Configuration
CACHE_TTL=3600
CACHE_PREFIX=recs

# Recommendation Configuration
REC_K=10
FALLBACK_ITEMS=20

# Environment
ENVIRONMENT=development